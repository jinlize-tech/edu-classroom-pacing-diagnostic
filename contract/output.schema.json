    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "title",
          "source_type",
          "verification_status"
        ],
        "properties": {
          "title": {
            "type": "string"
          },
          "url": {
            "type": "string"
          },
          "source_date": {
            "type": "string"
          },
          "source_type": {
            "type": "string"
          },
          "excerpt": {
            "type": "string"
          },
          "verification_status": {
            "type": "string",
            "enum": [
              "verified",
              "provided_by_user",
              "unverified",
              "not_required"
            ]
          }
        }
      }
    },
    "assumptions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "open_questions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "human_review": {
      "type": "object",
      "required": [
        "required",
        "review_points"
      ],
      "properties": {
        "required": {
          "type": "boolean"
        },
        "reviewer_role": {
          "type": "string"
        },
        "review_points": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "confirmed": {
          "type": "boolean",
          "default": false
        }
      },
      "additionalProperties": false
    },
    "errors": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "code",
          "message"
        ],
        "properties": {
          "code": {
            "type": "string",
            "enum": [
              "INPUT_MISSING",
              "INPUT_INVALID",
              "INPUT_CONFLICT",
              "OUT_OF_SCOPE",
              "SENSITIVE_DATA",
              "EVIDENCE_UNVERIFIED",
              "TOOL_UNAVAILABLE",
              "HUMAN_REVIEW_REQUIRED",
              "CALCULATION_FAILED",
              "INDEPENDENCE_VIOLATION",
              "OUTPUT_INCOMPLETE"
            ]
          },
          "message": {
            "type": "string",
            "minLength": 1
          },
          "field": {
            "type": "string"
          },
          "severity": {
            "type": "string",
            "enum": [
              "info",
              "warning",
              "error",
              "blocking"
            ]
          },
          "next_action": {
            "type": "string"
          }
        },
