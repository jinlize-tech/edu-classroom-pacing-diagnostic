    "status_reason": {
      "type": "string",
      "minLength": 1
    },
    "next_action": {
      "type": "string",
      "minLength": 1
    },
    "limitation_reason": {
      "type": "string",
      "minLength": 1
    },
    "completed_scope": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1
    },
    "blocked_scope": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1
    }
  },
  "allOf": [
    {
      "if": {
        "required": [
          "status"
        ],
        "properties": {
          "status": {
            "const": "completed"
          }
        }
      },
      "then": {
        "required": [
          "deliverables",
          "evidence",
          "assumptions",
          "open_questions",
          "human_review",
          "errors",
          "next_action"
        ],
        "properties": {
          "deliverables": {
            "minProperties": 1,
            "required": [
              "时间分布图文本",
              "活动序列",
              "目标保障风险"
            ]
          },
          "errors": {
            "maxItems": 0
          }
        }
      }
    },
    {
      "if": {
        "required": [
          "status"
        ],
        "properties": {
          "status": {
            "const": "completed_with_limits"
          }
        }
      },
      "then": {
        "required": [
          "deliverables",
          "evidence",
          "assumptions",
          "open_questions",
          "human_review",
          "errors",
          "next_action",
          "limitation_reason",
          "completed_scope",
          "blocked_scope"
        ],
        "properties": {
          "deliverables": {
            "minProperties": 1
          },
          "open_questions": {
            "minItems": 1
          },
          "errors": {
            "minItems": 1
          },
          "limitation_reason": {
            "minLength": 1
          },
          "completed_scope": {
            "minItems": 1
          },
          "blocked_scope": {
            "minItems": 1
          }
        }
      }
    },
    {
      "if": {
        "required": [
          "status"
        ],
        "properties": {
          "status": {
            "const": "needs_input"
          }
        }
      },
      "then": {
        "required": [
          "open_questions",
          "errors",
          "next_action"
        ],
        "properties": {
          "deliverables": {
            "minProperties": 0
          },
          "open_questions": {
            "minItems": 1
          },
          "errors": {
            "minItems": 1
          }
        }
      }
    },
    {
      "if": {
        "required": [
          "status"
        ],
        "properties": {
          "status": {
            "const": "needs_confirmation"
          }
        }
      },
      "then": {
        "required": [
          "open_questions",
          "human_review",
          "errors",
          "next_action"
        ],
        "properties": {
          "deliverables": {
            "minProperties": 0
          },
          "open_questions": {
            "minItems": 1
          },
          "human_review": {
            "required": [
              "required",
              "review_points"
            ],
            "properties": {
              "required": {
                "const": true
              },
              "confirmed": {
                "const": false
              },
              "review_points": {
                "minItems": 1
              }
            }
          },
          "errors": {
            "minItems": 1
          }
        }
      }
    },
    {
      "if": {
        "required": [
          "status"
        ],
        "properties": {
          "status": {
            "const": "failed"
          }
        }
      },
      "then": {
        "required": [
          "errors",
          "next_action"
        ],
        "properties": {
          "errors": {
            "minItems": 1
          }
        }
      }
    }
  ],
  "x-g0-completion-rules": {
    "core_outputs": [
      "时间分布图文本",
      "活动序列",
      "目标保障风险"
    ],
    "optional_outputs": [
      "过渡耗时",
      "改进实验",
      "复盘指标"
    ],
    "empty_optional_lists_allowed": true,
    "placeholder_text_forbidden": true,
    "completed_with_limits_requires": [
      "limitation_reason",
      "completed_scope",
      "blocked_scope"
    ]
  }
